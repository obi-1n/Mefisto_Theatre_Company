@model ONnegha_Mefisto_Theatre_Company.Models.Post

@{
    ViewBag.Title = "Delete Post";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="h4 mb-0">Delete Post</h2>
                </div>
                <div class="card-body">
                    <h3 class="h5 text-danger mb-4">Are you sure you want to delete this post?</h3>
                    
                    <div class="mb-4">
                        <label class="fw-bold d-block text-muted small text-uppercase">Title</label>
                        <p class="lead">@Html.DisplayFor(model => model.Title)</p>
                    </div>

                    <div class="mb-4">
                        <label class="fw-bold d-block text-muted small text-uppercase">Date Posted</label>
                        <p>@Html.DisplayFor(model => model.DatePosted)</p>
                    </div>

                    <div class="mb-4">
                        <label class="fw-bold d-block text-muted small text-uppercase">Content</label>
                        <div class="p-3 bg-light rounded text-break" style="max-height: 200px; overflow-y: auto;">
                            @Html.DisplayFor(model => model.Content)
                        </div>
                    </div>

                    @using (Html.BeginForm()) {
                        @Html.AntiForgeryToken()
                        <div class="d-grid gap-2">
                            <input type="submit" value="Delete Permanently" class="btn btn-danger btn-lg" />
                            @Html.ActionLink("Cancel and Back", "Index", "Home", null, new { @class = "btn btn-outline-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
