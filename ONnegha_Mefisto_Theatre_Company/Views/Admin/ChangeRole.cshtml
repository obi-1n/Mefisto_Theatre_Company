@model ONnegha_Mefisto_Theatre_Company.ViewModels.ChangeRoleViewModel

@{
    ViewBag.Title = "Change Role";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">Change Staff Role</h2>
                    <hr />

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-4 text-center">
                            <p class="text-muted mb-1">Changing role for</p>
                            <h4 class="fw-bold">@Model.UserName</h4>
                        </div>

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Role, htmlAttributes: new { @class = "form-label" })
                            @Html.DropDownListFor(model => model.Role, Model.Roles, new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <input type="submit" value="Update Role" class="btn btn-primary btn-lg" />
                            @Html.ActionLink("Back to Staff List", "ViewAllStaff", null, new { @class = "btn btn-outline-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>