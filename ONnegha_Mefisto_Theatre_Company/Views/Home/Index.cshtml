@model List<ONnegha_Mefisto_Theatre_Company.Models.Post>
@{
    ViewBag.Title = "Index";
}

<h1 class="text-center mb-4">Mefisto Theatre Company</h1>

@if (!Model.Any())
{
    <p class="text-center">No posts available yet.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var post in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary">@post.Title</h5>
                        <p class="text-muted small">
                            By <strong>@post.Staff.FirstName</strong> on @post.DatePosted.ToString("yyyy-MM-dd")
                        </p>
                        <p class="card-text">
                            @if (post.Content.Length > 120)
                            {
                                @post.Content.Substring(0, 120) <text>...</text>
                            }
                            else
                            {
                                @post.Content
                            }
                        </p>
                        <div class="mt-auto pt-3">
                            <a href="@Url.Action("PostDetails", "Home", new { id = post.PostId })"
                               class="btn btn-outline-primary w-100">
                                Read More
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
