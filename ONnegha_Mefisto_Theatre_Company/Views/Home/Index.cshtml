@model List<ONnegha_Mefisto_Theatre_Company.Models.Post>
@{
    ViewBag.Title = "Index";
}

<h1 class="text-center mb-4">Mefisto Theatre Company</h1>

@if (!Model.Any())
{
    <p class="text-center">No posts available yet.</p>
}
else
{
    <div class="row">
        @foreach (var post in Model)
        {
            <div class="col-md-4 d-flex justify-content-center mb-4">
                <div class="card h-100 w-100" style="max-width: 300px; height: 400px;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@post.Title</h5>
                        <p class="text-muted">By @post.Staff.FirstName on @post.DatePosted.ToString("yyyy-MM-dd")</p>
                        <p class="card-text">
                            @if (post.Content.Length > 100)
                            {
                                @post.Content.Substring(0, 100) <text>...</text>
                            }
                            else
                            {
                                @post.Content
                            }
                        </p>
                        <div class="mt-auto">
                            <a href="@Url.Action("PostDetails", "Home", new { id = post.PostId })"
                               class="btn btn-primary w-100">
                                Read More
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
