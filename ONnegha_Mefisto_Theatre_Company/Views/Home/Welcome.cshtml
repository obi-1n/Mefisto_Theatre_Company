@{
    Layout = null;
    ViewBag.Title = "Welcome";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mefisto Theatre</title>
    <style>
        body {
            background-color: #e6f2ff;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .welcome-link {
            font-size: 15vw; /* Use viewport units for responsiveness */
            text-decoration: none;
            font-weight: bold;
            color: #333;
            transition: transform 0.3s ease, color 0.3s ease;
            text-align: center;
            max-width: 90%; /* Prevent it from touching the sides */
        }
        /* Cap the font size for very large screens */
        @@media (min-width: 1200px) {
            .welcome-link {
                font-size: 180px;
            }
        }
        /* Adjust for mobile screens to ensure it stays readable */
        @@media (max-width: 600px) {
            .welcome-link {
                font-size: 20vw;
            }
        }
        .welcome-link:hover {
            transform: scale(1.1);
            color: #0056b3;
        }
    </style>
</head>
<body>
    <a href="@Url.Action("Index", "Home")" class="welcome-link">WELCOME!</a>
</body>
</html>


