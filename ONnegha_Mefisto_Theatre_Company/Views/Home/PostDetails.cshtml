@model ONnegha_Mefisto_Theatre_Company.Models.Post
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = Model.Title;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg mt-4">
                <div class="card-body">
                    <h1 class="text-center">@Model.Title</h1>
                    <p class="text-muted text-center">By <strong>@Model.Staff.FirstName @Model.Staff.LastName</strong> | Published on @Model.DatePosted.ToString("MMMM dd, yyyy")</p>
                    <hr />

                    <div class="content">
                        <p>@Model.Content</p>
                    </div>

                    <hr />
                    <h3>Comments</h3>

                    @if (Model.Comments.Any())
                    {
                        <ul class="list-group">
                            @* only display approved comments
                                comments made by suspended users are automatically flagged as unapproved and wont display in the comment section*@
                            @foreach (var comment in Model.Comments.Where(c => c.isApproved))
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                                        <div>
                                            <strong>@comment.Member.FirstName</strong> <span class="text-muted small">(@comment.dateCommented.ToString("dd MMM yyyy"))</span><br />
                                            <p class="mb-1">@comment.Content</p>
                                        </div>
                                        <div class="d-flex gap-2 mt-2 mt-sm-0">
                                            @*Only admins moderators and the member that created the comment get the option to delete a comment*@
                                            @if (User.IsInRole("Admin") || User.IsInRole("Moderator") || comment.MemberId == User.Identity.GetUserId())
                                            {
                                                <a class="btn btn-sm btn-outline-danger"
                                                   href="@Url.Action("Delete", "Comment", new { id = comment.CommentId })">Delete</a>
                                            }
                                            @* Only the member that created the comment have the option to edit it *@
                                            @if (comment.MemberId == User.Identity.GetUserId())
                                            {
                                                <a class="btn btn-sm btn-outline-primary"
                                                   href="@Url.Action("EditComment", "Member", new { id = comment.CommentId })">Edit</a>
                                            }
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No comments yet.</p>
                    }

                    @* display suspension message if user is suspended *@
                    @if (User.IsInRole("Suspended"))
                    {
                        <p>You have been Suspended due to misconduct, and can not leave comments</p>
                    }

                    @* display add comment form if user is a registered member *@
                    @if (User.IsInRole("Member"))
                    {
                        <hr />

                        using (Html.BeginForm("CreateComment", "Comment", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="PostId" value="@Model.PostId" />

                            <div class="mb-3">
                                <label class="form-label">Comment</label>
                                <textarea name="Content" class="form-control" required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary">Submit</button>
                        }

                    }

                    @* All editors and admins can delete a post *@
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <a class="btn btn-secondary" href="@Url.Action("Index", "Home")">Back to Blog</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                        {
                            <a class="btn btn-danger"
                               href="@Url.Action("DeletePost", "Post", new { id = Model.PostId })">Delete</a>
                        }
                        @* Only the editor that made the post has the option to edit it *@
                        @if (User.IsInRole("Editor") && Model.Staff.Id == User.Identity.GetUserId())
                        {
                            <a class="btn btn-primary"
                               href="@Url.Action("Edit", "Editor", new { id = Model.PostId })">Edit</a>
                        }
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>
